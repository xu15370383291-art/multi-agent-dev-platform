COMPANY_DATABASE_URL=postgresql+psycopg://company:company_local@127.0.0.1:55432/company
COMPANY_WORKSPACE_ROOT=../.local/projects
COMPANY_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
COMPANY_PREVIEW_BASE_URL=http://127.0.0.1:8001
COMPANY_FRONTEND_API_TARGET=http://127.0.0.1:8000
COMPANY_FRONTEND_DIST=../frontend/dist
# Model keys belong in Windows Credential Manager through the workbench, never here.
COMPANY_RUN_MAX_MODEL_CALLS=60
COMPANY_RUN_CALL_POLICY=progress_guarded
COMPANY_RUN_MAX_SECONDS=3600
COMPANY_EXECUTION_IMAGE=agent-company-executor:m3
COMPANY_QUALITY_IMAGE=agent-company-quality:m16
COMPANY_REVIEWED_QUALITY_CORRECTIONS_ENABLED=true
# Explicit opt-in for the approved docs/60 published-version verification workflow.
COMPANY_SUPPLEMENTAL_VERIFICATION_ENABLED=false
COMPANY_EXECUTION_MEMORY_MB=768
COMPANY_EXECUTION_CPUS=1
COMPANY_EXECUTION_PIDS=128
COMPANY_EXECUTION_WORKSPACE_MB=256
COMPANY_EXECUTION_TOTAL_SLOTS=2
COMPANY_DEVELOPMENT_CONCURRENCY=2
COMPANY_TOOL_TIMEOUT_SECONDS=60
COMPANY_TOOL_OUTPUT_BYTES=65536

# Cumulative ceilings above apply only to historical/fixed policy; progress v2 uses null.
COMPANY_PROGRESS_EXECUTION_IMAGE=agent-company-executor:m4
COMPANY_PROGRESS_QUALITY_IMAGE=agent-company-quality:m16
# Rolling no-observable-activity window, never an absolute command duration.
COMPANY_TOOL_IDLE_SECONDS=180
