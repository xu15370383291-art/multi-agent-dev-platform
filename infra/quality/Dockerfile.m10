FROM agent-company-quality:m9
USER root
RUN apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=20 update \
    && apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=20 install -y --no-install-recommends fonts-wqy-microhei ca-certificates \
    && fc-cache -f && rm -rf /var/lib/apt/lists/*
LABEL company.quality-cjk-fonts="wqy-microhei-v1"
USER 1000:1000
